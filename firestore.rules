rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if isValidId(examId);

      match /session/{sessionId} {
        allow read: if true;
        allow write: if isValidId(sessionId);
      }

      match /students/{studentId} {
        allow read: if true;
        allow write: if isValidId(studentId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
